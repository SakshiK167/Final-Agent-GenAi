# OpenRouter API Key (Get yours at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OpenRouter Model Identifier
# Check https://openrouter.ai/models for current availability
# Free-tier recommended example: meta-llama/llama-3.1-8b-instruct:free
# Alternative options: openai/gpt-4o-mini, google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=openai/gpt-4o-mini

# Streamlit Server Port (Render injects PORT dynamically; 8501 locally)
PORT=8501
